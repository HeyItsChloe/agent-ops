# Copy to .env and fill in — never commit the real .env file.

# Shared-secret auth for /trigger, /webhook/github, /webhook/mcp (roadmap Phase 2, step 3)
ORCHESTRATOR_SHARED_SECRET=

# LiteLLM gateway — currently the same value as LITELLM_MASTER_KEY, since
# Postgres (and with it, separately-scoped virtual keys) isn't running for
# now (litellm/config.yaml). Swap this for a real scoped key once Postgres
# is added back.
LITELLM_PROXY_URL=https://your-litellm-host/v1
LITELLM_VIRTUAL_KEY=

# GitHub App (replaces PAT — see docs/multi-pipeline-agent-strategy.md §7)
GH_APP_ID=
GH_APP_PRIVATE_KEY=
GH_WEBHOOK_SECRET=
# Org installation (11thandOrange) — dev-ticket-pipeline dispatch, e.g. BusyBuddy_v2.
GH_APP_INSTALLATION_ID=
# Personal account installation (heyitschloe) — job-search pipeline's own
# skill fetch from this repo, the-store append. A token minted against the
# wrong installation for either 404s at the token-minting step.
GH_APP_INSTALLATION_ID_PERSONAL=

# Allowlisted GitHub usernames whose @dev-agent comments are honored (§4.1)
ALLOWED_MENTION_AUTHORS=heyitschloe

# Where the skills + registry this deployment reads live — defaults to
# HeyItsChloe/agent-ops@main if unset, which is correct for this repo's own
# deployment. REGISTRY_PATH defaults to this repo's own bundled
# registry/pipelines.yaml if unset.
CONTROL_REPO_OWNER=HeyItsChloe
CONTROL_REPO_NAME=agent-ops
CONTROL_REPO_BRANCH=main
REGISTRY_PATH=

# Personal pipeline (roadmap Phase 7) — the orchestrator calls the gateway
# directly here, since personal projects have no repo/CI runner to dispatch
# to (strategy doc §5.3). Same LITELLM_PROXY_URL/LITELLM_VIRTUAL_KEY the dev
# pipeline's GitHub Actions jobs use.
LITELLM_PROXY_URL=https://your-litellm-host/v1
LITELLM_VIRTUAL_KEY=

# Optional — only needed if a personal project's sourcing_method is "api".
# api_provider/apiProvider picks which authorized job-search API is used
# (registry default or per-call override — see jobs/sourcing/api/resolver.ts);
# jsearch (OpenWebNinja's Job Search API, via API.market) is the only
# provider today. Verified live against a real API.market request/response —
# JSEARCH_API_KEY is sent as the x-api-market-key header.
JSEARCH_API_KEY=
JSEARCH_BASE_URL=https://prod.api.market/api/v1/openwebninja/jobsearch

# Optional — only needed if a personal project's sourcing_method is
# "scraping", or its strategy is "scrapeAll". A directory of saved
# Playwright storage-state files, one per site, named "<hostname>.json"
# (e.g. "linkedin.com.json") — resolved by the URL's hostname at the point
# of use (see integrations/site_sessions.ts), not a single fixed site.
# (Revised — this used to be LINKEDIN_STORAGE_STATE_PATH, a single path,
# which made no sense for scrapeAll's genuinely multi-site crawling.) A
# site with no matching file proceeds unauthenticated rather than erroring.
SITE_SESSIONS_DIR=

# Optional — only needed if a personal project's strategy is "scrapeAny",
# and only for whichever search_provider it's configured to use (registry
# default or per-call override — see jobs/discovery/scrapeAny.ts). Set
# either or both; each provider is independent.
#
# serpapi: SerpAPI wraps Google's SERP as structured JSON. Get a key at
# https://serpapi.com/manage-api-key.
SERPAPI_API_KEY=
#
# claude_web_search: Anthropic's server-side web_search tool does the
# actual searching — no separate search vendor, but it calls Anthropic's
# Messages API directly (not through LITELLM_VIRTUAL_KEY/LITELLM_PROXY_URL),
# so it needs its own key from https://console.anthropic.com/.
ANTHROPIC_API_KEY=
#
# jsearch: same JSEARCH_API_KEY/JSEARCH_BASE_URL configured above for
# sourcing_method: api — no separate credential needed.

# Optional — only needed to expose the Chrome extension's lookup endpoint
# (GET /personal-projects/:project/applications, heyitschloe/extensions).
# Deliberately separate from ORCHESTRATOR_SHARED_SECRET, since the
# extension's code/storage is inspectable in a way a server env var isn't.
# The endpoint isn't mounted at all while this is unset.
EXTENSION_API_KEY=

# Optional — completed job applications are appended as CSV rows to a
# separate repo ("the-store"), not agent-ops itself. Unset until that repo
# exists; appends are skipped (with a warning log) while unset, not a hard
# failure. See integrations/the_store.ts.
THE_STORE_OWNER=
THE_STORE_REPO=
THE_STORE_BRANCH=main
THE_STORE_PATH=projects/job-applications/job-app-results.csv

# Optional as a whole (gated by the five required fields below all being
# set) — background the drafting model reads from so formFields/
# applicationSummary/resume/coverLetter answer truthfully instead of
# inventing the applicant's identity or history. Entirely separate from
# resume_source/cover_letter_source (registry) — those control what
# document the *output* contains; these control what the model *knows*
# about the applicant while drafting. See integrations/google_drive.ts.
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_PROFESSIONAL_SUMMARY=
# A Google Drive link to the applicant's actual resume, shared as "Anyone
# with the link can view" — fetched live as text on every request (once
# per request, not per-candidate), no credential needed since the link is
# public. Works for a native Google Doc (exported as plain text) or an
# uploaded PDF (downloaded and parsed); .docx and other formats aren't
# supported. A fetch failure is logged and drafting proceeds without it,
# not a hard failure.
APPLICANT_RESUME_GDRIVE_LINK=
# All optional — fill in whichever fields you want available for drafting.
APPLICANT_LOCATION=
APPLICANT_LINKEDIN_URL=
APPLICANT_PORTFOLIO_URL=
APPLICANT_CURRENT_TITLE=
APPLICANT_CURRENT_EMPLOYER=
APPLICANT_YEARS_EXPERIENCE=
APPLICANT_WORK_AUTHORIZATION=
APPLICANT_SPONSORSHIP_REQUIRED=
APPLICANT_DESIRED_SALARY=
APPLICANT_AVAILABILITY=

PORT=3000

# ---------------------------------------------------------------------------
# Outreach pipeline (issue #11) — automated daily scraping + Gmail-DRAFT
# outreach. All optional/feature-gated: an unset integration is skipped with
# a warning (fail-open), never a hard failure. The pipeline NEVER sends email
# — it only ever creates Gmail drafts (enforced in integrations/gmail.ts +
# gmail.test.ts). Reuses GH_APP_* (personal install), LITELLM_*, THE_STORE_*,
# and SERPAPI_API_KEY/ANTHROPIC_API_KEY (discovery) from above.

# LiteLLM model alias used for enrichment + email generation (default "planning").
OUTREACH_MODEL_ALIAS=planning
# Base path in the-store for outreach data (default projects/outreach/payment-processors).
OUTREACH_STORE_PATH=projects/outreach/payment-processors

# Gmail — DRAFTS ONLY. OAuth2 refresh-token grant. Never logged, never sends.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The account drafts are created under (the "From" address).
GMAIL_SENDER=

# Discord completion/failure summary. Webhook wins if both are set.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
